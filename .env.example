# Copy this file to .env.local and fill in real values for local development.
# .env.local is git-ignored — never commit real keys.

# 'mock' (default if unset) powers the app from src/repositories/mock/* and
# needs nothing else below. 'supabase' switches to the real database via
# src/repositories/supabase/* and requires both variables below.
VITE_DATA_PROVIDER=mock

# Local Supabase API URL (from `npx supabase status`). Default local port is 54321.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# The PUBLISHABLE (anon-equivalent) key ONLY — from `npx supabase status`
# (PUBLISHABLE_KEY, e.g. "sb_publishable_..."). NEVER put the secret key or
# service-role key here: this value ships into the browser bundle. RLS
# (Stage 2A Checkpoint 4) is the real security boundary, not this key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_local_key_here
